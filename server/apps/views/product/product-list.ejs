<!DOCTYPE html>
<html>

<head>
    <title>Product List</title>
    <link rel="stylesheet" href="/static/css/bootstrap.css">
</head>

<body>
    <div class="container">
        <h2>Product List</h2>
        <a href="/product/create-product" class="btn btn-primary mb-3">Create New Product</a>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Description</th>
                    <th>Image</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (products && products.length> 0) { %>
                    <% products.forEach(function(product) { %>
                        <tr>
                            <td>
                                <%= product.Name %>
                            </td>
                            <td>$<%= product.Price %>
                            </td>
                            <td>
                                <%= product.Description %>
                            </td>
                            <td>
                                <% if (product.productimage) { %>
                                    <img src="data:image/png;base64,<%= product.productimage.toString('base64') %>"
                                        alt="<%= product.Name %>" style="width: 100px; height: 100px;">
                                    <% } else { %>
                                        No image available
                                        <% } %>
                            </td>
                            <td>
                                <a href="/product/update-product?id=<%= product._id %>" class="btn btn-info">Edit</a>
                                <a href="/product/delete-product?id=<%= product._id %>"
                                    class="btn btn-danger">Delete</a>
                            </td>
                        </tr>
                        <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5">No products found.</td>
                                </tr>
                                <% } %>
            </tbody>
        </table>
    </div>
</body>

</html>